# ------------------------------------------------------------------
# OmniSell OS — environment template. Copy to .env and adjust.
# ------------------------------------------------------------------

# Core
DATABASE_URL=postgresql://omnisell:omnisell@localhost:5432/omnisell
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=dev-access-secret-32-bytes-minimum-000
JWT_REFRESH_SECRET=dev-refresh-secret-32-bytes-minimum-00
KMS_MASTER_KEY=aGVyZS1pcy0zMi1ieXRlLWJhc2U2NC1rZXktZmVkY2Jh
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=omnisell-assets
S3_ACCESS_KEY=omnisell
S3_SECRET_KEY=omnisell-secret
EXPORT_PACK_SCRATCH_DIR=./.export-pack-scratch  # generated Export Pack ZIPs (Phase 4 task 4.12)
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
MOBILE_URL=exp://localhost:8081
# Connector OAuth callbacks (Phase 3 task 3.3) are built from API_URL directly
# (${API_URL}/v1/oauth/callback/:slug) — no separate OAUTH_CALLBACK_BASE var.

# Google/Apple OAuth SSO (Phase 1.3) — left blank on purpose. Absent credentials
# make /v1/auth/oauth/:provider/start|callback answer 501
# oauth_provider_not_configured instead of crashing or faking a session. See
# docs/DEBT.md (1-D2) — a product owner must supply real values before this ships.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/oauth/callback/GOOGLE
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:4000/v1/auth/oauth/callback/APPLE

# Printful OAuth (Phase 3 task 3.3) — left blank on purpose, same reasoning as
# Google/Apple above. See docs/DEBT.md 3-D6.
PRINTFUL_OAUTH_CLIENT_ID=
PRINTFUL_OAUTH_CLIENT_SECRET=
CONNECTOR_OAUTH_STATE_TTL_MINUTES=10
CONNECTION_HEALTH_SAMPLE_RETENTION=50

# TOTP MFA + invites (Phase 1.3 / 1.6)
MFA_ISSUER=OmniSell
MFA_CHALLENGE_TTL_MINUTES=10
INVITE_TTL_DAYS=7

# Transactional email (Mailpit in dev — see docker-compose.yml)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=OmniSell <no-reply@omnisell.dev>
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Consumer points & wallet (Phase 4.5) — see docs/points-extension.md §12
POINTS_VIDEO_MIN_WATCH_SECONDS=30
POINTS_DAILY_EARNING_CAP=500
POINTS_FRAUD_DETECTION_ENABLED=true
POINTS_HEARTBEAT_INTERVAL_SECONDS=5
POINTS_MAX_WATCHES_PER_DAY=10

# Observability (optional — degrade gracefully)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# E2E / dev gates
E2E=0
NODE_ENV=development