# ------------------------------------------------------------------
# GlobalMart marketplace-api — environment template. Copy to .env and
# adjust. No real secrets in this file, ever.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4100

# The one flag that matters most in this sandbox: with no live Postgres or
# geolocation credential available, MOCK_MODE=true makes the whole API
# boot and serve real responses from in-memory repositories/providers
# instead of failing to start. Set to false only once MARKETPLACE_DATABASE_URL
# (and, later, IP_GEOLOCATION_API_KEY) point at real infrastructure.
MOCK_MODE=true

# Deliberately a DIFFERENT variable name than OmniSell's own DATABASE_URL
# so the two apps' env vars never collide if both .env files are ever
# merged into one. Left blank — MOCK_MODE=true does not require it.
MARKETPLACE_DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/globalmart

# Used to sign/verify auth JWTs. In development, if left blank, the app
# falls back to a fixed development-only secret and prints a warning —
# it refuses to start with no JWT_SECRET when NODE_ENV=production.
JWT_SECRET=dev-only-change-me-32-bytes-minimum-marketplace

# CORS allow-origin for marketplace-web (credentials: true, so this must
# be an exact origin, not "*").
MARKETPLACE_WEB_URL=http://localhost:3100

# Real IP geolocation vendor key. Left blank on purpose — no real
# geolocation vendor contract was provided for this build, so only a
# GeolocationProvider interface + MockGeolocationProvider exist so far.
# See docs/marketplace/DEBT.md.
IP_GEOLOCATION_API_KEY=

# CJ Dropshipping API placeholders for a LATER phase's CJDropshippingProvider
# adapter (documented endpoint paths only, see docs/marketplace/DEBT.md —
# no adapter is built yet). NEVER put a real key here or in any committed
# file; the key pasted in chat during planning is treated as compromised
# and was never used, stored, or logged anywhere in this codebase.
CJ_API_KEY=
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
