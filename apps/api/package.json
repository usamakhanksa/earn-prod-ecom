{
  "name": "@omnisell/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "npm-run-all2 test:integration:containers",
    "test:integration:containers": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed-main.ts",
    "db:studio": "prisma studio",
    "axe": "node tools/axe.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@casl/ability": "6.7.2",
    "@nestjs/common": "10.4.4",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/terminus": "10.2.3",
    "@omnisell/connectors": "workspace:*",
    "@omnisell/i18n": "workspace:*",
    "@omnisell/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "bullmq": "5.28.1",
    "dotenv": "16.4.5",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsqr": "^1.4.0",
    "nestjs-pino": "4.1.0",
    "nodemailer": "6.9.16",
    "otplib": "12.0.1",
    "pdf-lib": "^1.17.1",
    "pino": "9.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@omnisell/config": "workspace:*",
    "@types/express": "5.0.0",
    "@types/node": "22.7.5",
    "@types/nodemailer": "6.4.16",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "6.0.2",
    "pino-pretty": "11.2.2",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.3"
  }
}