{
  "extends": "@omnisell/config/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "test", "prisma"],
  "exclude": ["node_modules", "dist"]
}